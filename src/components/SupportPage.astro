---
import { content } from '../data/content';
import { site, type Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
---

<div class="wrap wrap--narrow page page--support">
  <div class="page__head">
    <h1 class="page__h1">{t.support.h1}</h1>
    <p class="page__lede">{t.support.lede}</p>
  </div>

  <div class="contact">
    <div class="contact__text">
      <span class="contact__label">{t.support.emailLabel}</span>
      <a class="contact__address" href={`mailto:${site.email}`}>{site.email}</a>
      <span class="contact__hint">{t.support.emailHint}</span>
    </div>
    <a class="btn-solid" href={`mailto:${site.email}?subject=Habits`}>
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg
      >
      {t.support.writeEmail}
    </a>
  </div>

  <section class="faq" aria-labelledby="faq">
    <h2 id="faq" class="display faq__h2">{t.support.faqTitle}</h2>

    {/* The first question is the one most people arrive with, so it starts open. */}
    {
      t.support.faq.map((item, i) => (
        <details open={i === 0}>
          <summary>{item.q}</summary>
          <div class="faq__answer" set:html={item.answerHtml} />
        </details>
      ))
    }
  </section>
</div>
